# Nature's Alchemy - Backend Configuration
# Copy this file to .env and configure local values. 
# Do not commit the actual .env file or database files to version control.

# Server Port
PORT=5000

# CORS Whitelist Origin (Comma-separated for multiple origins)
# Wildcards (*) are strictly disallowed in production.
CORS_ORIGIN=http://localhost:5173

# SQLite Database Location
# Relative to server root or absolute path
DATABASE_PATH=./server/db/nature_alchemy.db

# Security & Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Placeholder Secrets (Update with secure values in production)
JWT_SECRET=placeholder_jwt_secret_for_local_development_only_change_in_production
SESSION_SECRET=placeholder_session_secret_for_local_development_only_change_in_production

# Payment Gateway — AzamPay (https://developerdocs.azampay.co.tz)
# The previous Selcom and Stakaba integrations have been removed. The AzamPay
# integration is not built yet; these are the values it will need. Credentials
# arrive with KYC approval. All are server-side only, never exposed to the frontend.
PAYMENTS_MODE=mock
# Sandbox hosts (production hosts are issued on go-live).
AZAMPAY_AUTH_BASE_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_CHECKOUT_BASE_URL=https://sandbox.azampay.co.tz
AZAMPAY_APP_NAME=your_registered_app_name
AZAMPAY_CLIENT_ID=your_client_id
AZAMPAY_CLIENT_SECRET=your_client_secret
# AzamPay callbacks are RSA-signed; the public key is fetched from their API
# and should be cached locally. AzamPay register the callback URL for you.
AZAMPAY_CALLBACK_URL=https://yourdomain.com/api/webhooks/azampay
AZAMPAY_REQUEST_TIMEOUT_MS=15000

# Card payments route through CoralCommerce (AzamPay white-labels them).
# Separate credential set and a different encryption scheme (Blowfish/AES).
CORALCOMMERCE_BASE_URL=https://dev.coralcommerce.com
CORALCOMMERCE_USERNAME=your_payserver_username
CORALCOMMERCE_PASSWORD=your_payserver_password
CORALCOMMERCE_ALIAS=your_merchant_alias
CORALCOMMERCE_ENCRYPTION_KEY=your_shared_encryption_key

# SQL Logging Control (set to true to print raw SQL to console)
DEBUG_SQL=false
