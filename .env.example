# Nature's Alchemy - Backend Configuration
# Copy this file to .env and configure local values. 
# Do not commit the actual .env file or database files to version control.

# Server Port
PORT=5000

# CORS Whitelist Origin (Comma-separated for multiple origins)
# Wildcards (*) are strictly disallowed in production.
CORS_ORIGIN=http://localhost:5173

# SQLite Database Location
# Relative to server root or absolute path
DATABASE_PATH=./server/db/nature_alchemy.db

# Security & Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Placeholder Secrets (Update with secure values in production)
JWT_SECRET=placeholder_jwt_secret_for_local_development_only_change_in_production
SESSION_SECRET=placeholder_session_secret_for_local_development_only_change_in_production

# Selcom Payment Gateway Configuration
# mock = no real Selcom calls; deterministic local behaviour (required for the
# webhook simulation harness). Selcom has NO sandbox — the first non-mock
# transaction is live, so keep mock on until go-live (see docs/SELCOM_GOLIVE.md).
SELCOM_MODE=mock
# NOTE: There is NO Selcom sandbox environment. The value below is a
# placeholder only — the real production base URL must be obtained from
# Selcom support (support@selcom.net) along with credentials.
SELCOM_BASE_URL=https://sandbox.selcom.co/v1
SELCOM_VENDOR_ID=placeholder_vendor_id
SELCOM_API_KEY=placeholder_api_key
SELCOM_API_SECRET=placeholder_api_secret
# Base webhook URL. The secret path segment (SELCOM_WEBHOOK_SECRET) is
# appended automatically and the full URL is sent per-order in the
# create-order `webhook` field — no dashboard configuration needed.
SELCOM_WEBHOOK_URL=https://yourdomain.com/api/webhooks/selcom
# Unguessable secret embedded in the webhook path. Selcom webhooks carry no
# signature, so the secret path (+ IP allowlist below) is how inbound webhooks
# are authenticated. Generate with: openssl rand -hex 24
SELCOM_WEBHOOK_SECRET=replace_with_a_long_random_secret
# Comma-separated IPs/CIDRs from Selcom support; empty = accept all (warned).
SELCOM_WEBHOOK_ALLOWED_IPS=
SELCOM_REDIRECT_URL=https://yourdomain.com/checkout/success
SELCOM_CANCEL_URL=https://yourdomain.com/checkout/cancel
SELCOM_REQUEST_TIMEOUT_MS=10000
SELCOM_STATUS_QUERY_MIN_INTERVAL_MS=30000

# Signed-Fields Lists (No timestamp inside Signed-Fields). Inbound webhooks
# are NOT signed (no webhook fields list) — these cover outbound requests only.
SELCOM_SIGNED_FIELDS_CREATE_ORDER_MINIMAL=vendor,order_id,buyer_email,buyer_name,buyer_phone,amount,currency,webhook,buyer_remarks,merchant_remarks,no_of_items
SELCOM_SIGNED_FIELDS_CREATE_ORDER=vendor,order_id,buyer_email,buyer_name,buyer_phone,amount,currency,payment_methods,redirect_url,cancel_url,webhook,billing.firstname,billing.lastname,billing.address_1,billing.city,billing.state_or_region,billing.postcode_or_pobox,billing.country,billing.phone,buyer_remarks,merchant_remarks,no_of_items
SELCOM_SIGNED_FIELDS_WALLET_PAYMENT=transid,order_id,msisdn
SELCOM_SIGNED_FIELDS_ORDER_STATUS=order_id

# Stakaba Payment Gateway (https://docs.stakaba.com)
# The same API key drives sandbox vs live: sk_test_ = simulated, sk_live_ = real.
# Keys are server-side only, never exposed to the frontend.
STAKABA_BASE_URL=https://api.stakaba.com
STAKABA_API_KEY=sk_test_your_sandbox_key_here
STAKABA_REQUEST_TIMEOUT_MS=15000
# Unguessable secret embedded in the webhook path. Configure the merchant
# dashboard webhook URL to: https://yourdomain.com/api/webhooks/stakaba/<this>
# Stakaba webhooks carry no signature, so this secret path is how inbound
# webhooks are authenticated. Generate with: openssl rand -hex 24
STAKABA_WEBHOOK_SECRET=replace_with_a_long_random_secret

# SQL Logging Control (set to true to print raw SQL to console)
DEBUG_SQL=false
