# Nature's Alchemy - Production Environment Variables Template
# Copy this file to .env in your production environment and fill in the values.
# NEVER commit the actual .env file to version control.

# Server configuration
PORT=5000
NODE_ENV=production

# Database configuration
# Path to your SQLite production database on persistent disk.
# Ensure file permissions restrict access to the application runner user only.
DATABASE_PATH=/var/lib/natures-alchemy/nature_alchemy.db

# JWT Security
# Set a high-entropy secret (e.g., generated via: openssl rand -base64 48)
JWT_SECRET=your_high_entropy_production_jwt_secret_here

# CORS Origin
# Multiple production origins are supported as a comma-separated list.
# Ensure no space is left around URLs if listing multiple origins.
CORS_ORIGIN=https://www.naturesalchemy.co,https://naturesalchemy.co

# Payment Gateway — AzamPay (production)
# The previous Selcom and Stakaba integrations have been removed. Fill these in
# once AzamPay KYC is approved and production credentials are issued. Keep
# server-side only; never expose to the frontend.
# Set to production only after mock verification passes.
PAYMENTS_MODE=mock

# Production hosts (issued by AzamPay on go-live).
AZAMPAY_AUTH_BASE_URL=https://authenticator.azampay.co.tz
AZAMPAY_CHECKOUT_BASE_URL=https://checkout.azampay.co.tz

AZAMPAY_APP_NAME=your_registered_app_name
AZAMPAY_CLIENT_ID=your_client_id
AZAMPAY_CLIENT_SECRET=your_client_secret

# AzamPay register the callback URL on their side; it must be publicly
# reachable over HTTPS. Callbacks are RSA-signed and verified against the
# public key fetched from their API.
AZAMPAY_CALLBACK_URL=https://yourdomain.com/api/webhooks/azampay
AZAMPAY_REQUEST_TIMEOUT_MS=15000

# Card payments route through CoralCommerce (white-labelled by AzamPay).
CORALCOMMERCE_BASE_URL=https://secure.coralcommerce.com
CORALCOMMERCE_USERNAME=your_payserver_username
CORALCOMMERCE_PASSWORD=your_payserver_password
CORALCOMMERCE_ALIAS=your_merchant_alias
CORALCOMMERCE_ENCRYPTION_KEY=your_shared_encryption_key

# Data retention periods (must match Privacy Policy section 9).
RETENTION_ABANDONED_CHECKOUT_MONTHS=12
RETENTION_AUDIT_LOG_MONTHS=12
RETENTION_ORDER_TAX_MONTHS=60
